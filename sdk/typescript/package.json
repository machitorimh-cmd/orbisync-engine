{
  "name": "@orbisync/client",
  "private": true,
  "version": "0.1.0",
  "description": "OrbiSync realtime client with canonical state and server-authoritative input",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "check": "tsc --noEmit",
    "generate": "cd ../.. && buf generate",
    "test": "tsx --test src/**/*.test.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:live": "tsx e2e/live-runtime.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.11",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
