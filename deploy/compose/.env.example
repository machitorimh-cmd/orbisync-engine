# Copy to the repository root as `.env` and adjust.
#
#   cp deploy/compose/.env.example .env
#
# Secrets are injected through environment variables only; they are never
# written into `orbisync.toml` (`observability-and-config.md` §6.4).

# --- PostgreSQL container ---
POSTGRES_USER=orbisync
POSTGRES_PASSWORD=orbisync-local-dev
POSTGRES_DB=orbisync
POSTGRES_PORT=5432
POSTGRES16_PORT=5433

# --- Server ---
# From the host (cargo run):
DATABASE_URL=postgres://orbisync:orbisync-local-dev@localhost:5432/orbisync
# From the `server` container, replace `localhost` with `postgres`.

# Ed25519 private key in PKCS#8 PEM form. Generate for local dev:
#   openssl genpkey -algorithm ed25519 | awk '{printf "%s\\n",$0}'   # single-line with \n escapes
# or keep newlines:  export ORBISYNC_TOKEN_SIGNING_KEY="$(cat ed25519.pem)"
# Do not commit the real key. Replace the placeholder before `docker compose up`.
# The server derives the public key from this private key and fails startup
# if the variable is missing or not a valid Ed25519 PKCS#8 PEM.
ORBISYNC_TOKEN_SIGNING_KEY=__REPLACE_WITH_ED25519_PRIVATE_PEM__

# Pagination HMAC key for opaque cursor signing. Separate from the signing key so
# rotation of one does not invalidate the other (V-04/CR-07/CR-16).
# Generate for local dev (32 random bytes, base64):
#   openssl rand -base64 32
# or: head -c 32 /dev/urandom | base64
# Do not commit the real key. Replace the placeholder before `docker compose up`.
# The server fails startup if the variable is missing, empty, or left as the placeholder
# (same fail-closed contract as ORBISYNC_TOKEN_SIGNING_KEY).
ORBISYNC_PAGINATION_HMAC_KEY=__REPLACE_WITH_RANDOM_32_BYTES__

# Refresh token HMAC key for opaque refresh token digest (V-10 / ADR-002).
# Separate from pagination HMAC so rotation of one does not invalidate the other.
# Generate for local dev (32 random bytes, base64):
#   openssl rand -base64 32
# or: head -c 32 /dev/urandom | base64
# Do not commit the real key. Replace the placeholder before `docker compose up`.
# The server fails startup if the variable is missing, empty, or left as the placeholder
# (same fail-closed contract as ORBISYNC_TOKEN_SIGNING_KEY).
ORBISYNC_REFRESH_TOKEN_HMAC_KEY=__REPLACE_WITH_RANDOM_32_BYTES__

# Realtime ticket HMAC key for opaque realtime ticket digest (RV-A C1 / ADR-002 §52).
# Separate from refresh/pagination HMACs so rotation of one does not invalidate the other.
# Generate for local dev (32 random bytes, base64):
#   openssl rand -base64 32
# Do not commit the real key. Replace the placeholder before `docker compose up`.
# The server fails startup if the variable is missing, empty, or left as the placeholder
# (same fail-closed contract as ORBISYNC_TOKEN_SIGNING_KEY).
ORBISYNC_REALTIME_TICKET_HMAC_KEY=__REPLACE_WITH_RANDOM_32_BYTES__
# Keep the authenticated database-backed verifier as the default. Set to true
# only for deliberate loopback-only stub development.
ORBISYNC_REALTIME_ALLOW_STUB_TICKET=false

# Idempotency HMAC key for change-password request_hash (P2-C1 / ADR-002 §52).
# Separate from refresh/pagination/realtime HMACs so a DB backup containing
# `request_hash` does not allow offline brute-force without this secret.
# Generate for local dev (32 random bytes, base64):
#   openssl rand -base64 32
# Do not commit the real key. Replace the placeholder before `docker compose up`.
# The server fails startup if the variable is missing, empty, or left as the placeholder
# (same fail-closed contract as ORBISYNC_TOKEN_SIGNING_KEY).
ORBISYNC_IDEMPOTENCY_HMAC_KEY=__REPLACE_WITH_RANDOM_32_BYTES__
ORBISYNC_EXTENSION_TOKEN_HMAC_KEY=__REPLACE_WITH_RANDOM_32_BYTES__

# Host cargo run: set ORBISYNC_SERVER_BIND=127.0.0.1:8080 manually. The
# Compose container binds 0.0.0.0:8080 internally and publishes it on the host
# loopback address below by default.
ORBISYNC_HOST_BIND=127.0.0.1
# Development-only browser origins for reference-web (5173) and admin-web
# (5174). Production must list only the exact HTTPS origins actually used.
ORBISYNC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ORBISYNC_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
ORBISYNC_OBSERVABILITY_LOG_FORMAT=pretty
ORBISYNC_OBSERVABILITY_LOG_LEVEL=debug
ORBISYNC_PORT=8080
